---
import EditorialLayout from '../layouts/EditorialLayout.astro';
import { site, contactHref } from '../config/site';
---

<EditorialLayout
  title="Get in touch"
  eyebrow="Contact"
  description="Email Daniel Schmid with questions about BrimFrame or Riff Racers."
  intro="If you have a question about BrimFrame or Riff Racers, you can reach me by email."
>
  <section class="editorial-split contact-section">
    <h2>Email</h2>
    <div class="prose">
      {contactHref ? (
        <>
          <p>I’m {site.developerName}, the developer behind BrimFrame.</p>
          <a
            class="contact-address"
            href={contactHref}
            aria-describedby="contact-hint"
          >
            <span class="contact-email">
              {site.contactEmail ?? 'Contact BrimFrame'}
            </span>
            <span class="contact-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
          <p class="contact-note" id="contact-hint">
            Opens your email app.
          </p>
        </>
      ) : (
        <>
          <p>Public contact details will be shared here when available.</p>
          <a class="text-link" href="/devlog/">
            Read the Devlog <span aria-hidden="true">↗</span>
          </a>
        </>
      )}
    </div>
  </section>
  {site.socialLinks.length > 0 && (
    <section class="editorial-split">
      <h2>Elsewhere</h2>
      <ul>
        {site.socialLinks.map((link) => (
          <li>
            <a href={link.url}>{link.label}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</EditorialLayout>
