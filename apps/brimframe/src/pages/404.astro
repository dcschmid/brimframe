---
import SiteLayout from '../layouts/SiteLayout.astro';
import LinkButton from '../components/LinkButton.astro';
---

<SiteLayout
  title="Page not found"
  description="This page doesn’t exist or has moved. Return to the BrimFrame homepage."
  noindex
>
  <div class="container not-found">
    <p class="eyebrow">404 / Page not found</p>
    <h1>Nothing here.</h1>
    <p>The page you were looking for doesn’t exist or has moved.</p>
    <div class="button-group">
      <LinkButton href="/" arrow>
        Back Home
      </LinkButton>
      <LinkButton href="/games/" variant="secondary">
        Explore Games
      </LinkButton>
    </div>
  </div>
</SiteLayout>
