---
import { Picture } from 'astro:assets';
import LinkButton from './LinkButton.astro';
import racing from '../assets/devlog/2026-10-grid-fights-back/grid-fights-back-iron-chorus-side-by-side.webp';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Daniel Schmid / Independent game developer</p>
      <h1 id="hero-title">
        I’m making
        <br />
        <em>Riff Racers.</em>
      </h1>
      <p class="hero-description">
        An arcade racer with shortcuts, jumps and twelve drivers who don’t like
        being overtaken. I’m building it on my own, in Germany.
      </p>
      <div class="button-group">
        <LinkButton href="/games/" arrow>
          About the game
        </LinkButton>
        <a class="text-link" href="/about/">
          Meet the developer <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <figure class="hero-scene">
      <Picture
        src={racing}
        alt="Karts racing side by side on the Iron Chorus track in Riff Racers."
        widths={[640, 960, 1440]}
        sizes="(min-width: 1280px) 720px, (min-width: 768px) 56vw, 100vw"
        formats={['avif', 'webp']}
        quality={90}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <span>Riff Racers / In development</span>
        <a href="/devlog/riff-racers-the-grid-fights-back/">
          The racing AI <span aria-hidden="true">↗</span>
        </a>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-bottom: 1px solid var(--border);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .hero-copy {
    min-width: 0;
  }
  h1 {
    font-family: var(--font-body);
    font-size: clamp(2.75rem, 5.5vw, 5rem);
    line-height: 1.04;
    letter-spacing: -0.065em;
    font-weight: 600;
  }
  h1 em {
    font-style: normal;
    color: var(--accent-soft);
  }
  .hero-description {
    color: var(--text-soft);
    max-width: 42ch;
    margin-block: 1.75rem 2rem;
  }
  .hero-scene {
    min-width: 0;
    margin: 0;
  }
  .hero-scene :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-top: 0.75rem;
    color: var(--muted);
    font-size: var(--fs-small);
  }
  figcaption a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  figcaption > span {
    align-self: center;
  }
  @media (max-width: 47.99rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .hero-scene :global(img) {
      aspect-ratio: 16 / 10;
    }
    h1 {
      font-size: clamp(2.5rem, 10vw, 4rem);
    }
  }
</style>
