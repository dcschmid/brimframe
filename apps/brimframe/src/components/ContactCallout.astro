---
import LinkButton from './LinkButton.astro';
---

<section class="contact-callout section" aria-labelledby="connect-title">
  <div class="container closing-grid">
    <div>
      <p class="eyebrow">Follow along</p>
      <h2 id="connect-title">
        Stay curious.
        <br />
        Stay connected.
      </h2>
    </div>
    <div>
      <p>
        I write about making Riff Racers in the devlog, including the parts that
        still need work.
      </p>
      <div class="button-group">
        <LinkButton href="/devlog/" arrow>
          Read the Devlog
        </LinkButton>
      </div>
    </div>
  </div>
</section>
