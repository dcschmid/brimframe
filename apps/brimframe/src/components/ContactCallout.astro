---
import LinkButton from './LinkButton.astro';
---

<section class="contact-callout section" aria-labelledby="connect-title">
  <div class="container closing-grid">
    <div>
      <p class="eyebrow">Work in progress</p>
      <h2 id="connect-title">
        What changed
        <br />
        since the last build?
      </h2>
    </div>
    <div>
      <p>
        In the devlog, I share what I’ve changed in Riff Racers, why I changed
        it and what still needs work.
      </p>
      <div class="button-group">
        <LinkButton href="/devlog/" arrow>
          Read the Devlog
        </LinkButton>
      </div>
    </div>
  </div>
</section>
