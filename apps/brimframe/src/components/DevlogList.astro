---
import type { CollectionEntry } from 'astro:content';
import DevlogCard from './DevlogCard.astro';
interface Props {
  posts: CollectionEntry<'devlog'>[];
  /** Load the first card eagerly; use only where it sits near the initial view. */
  eagerFirst?: boolean;
  featured?: boolean;
}
const { posts, eagerFirst = false, featured = false } = Astro.props;
---

{posts.length ? (
  <div
    class:list={[
      'devlog-grid',
      { 'devlog-grid-featured': featured && posts.length > 1 },
    ]}
  >
    {posts.map((post, index) => (
      <DevlogCard
        post={post}
        wide={posts.length === 1 || (featured && index === 0)}
        eager={eagerFirst && index === 0}
      />
    ))}
  </div>
) : (
  <div class="devlog-empty">
    <h3>No posts yet.</h3>
    <p>I’ll post updates on Riff Racers here as development progresses.</p>
  </div>
)}
