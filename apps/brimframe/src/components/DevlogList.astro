---
import type { CollectionEntry } from 'astro:content';
import DevlogCard from './DevlogCard.astro';
interface Props {
  posts: CollectionEntry<'devlog'>[];
  /** Load the first card eagerly; use only where it sits near the initial view. */
  eagerFirst?: boolean;
}
const { posts, eagerFirst = false } = Astro.props;
---

{posts.length ? (
  <div class="devlog-grid">
    {posts.map((post, index) => (
      <DevlogCard
        post={post}
        wide={posts.length === 1}
        eager={eagerFirst && index === 0}
      />
    ))}
  </div>
) : (
  <div class="devlog-empty">
    <h3>No posts yet.</h3>
    <p>
      When I have an update to share, I’ll write about the work on Riff Racers
      here.
    </p>
  </div>
)}
