---
import { values } from '../config/values';
---

<div class="values-grid">
  {values.map((value, index) => (
    <div class="value">
      <>
        <span class="value-number" aria-hidden="true">
          0{index + 1}
        </span>
        <h3>{value.title}</h3>
        <p>{value.description}</p>
      </>
    </div>
  ))}
</div>
